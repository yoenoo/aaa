  "indexes": {
    "auth": {
      "name": "auth",
      "description": "authentication events (AD, Entra ID, VPN, service accounts)",
      "retention_days": 90
    },
    "dns": {
      "name": "dns",
      "description": "internal and external DNS query logs (Palo Alto DNS Security)",
      "retention_days": 30
    },
    "email": {
      "name": "email",
      "description": "email gateway events, phishing reports, quarantine actions",
      "retention_days": 60
    },
    "phishing": {
      "name": "phishing",
      "description": "user-reported phishing queue",
      "retention_days": 180
    },
    "proxy": {
      "name": "proxy",
      "description": "web-proxy logs (Zscaler)",
      "retention_days": 30
    },
    "network": {
      "name": "network",
      "description": "network flow logs (pcap summaries, netflow)",
      "retention_days": 14
    },
    "vpn": {
      "name": "vpn",
      "description": "corporate VPN connection logs",
      "retention_days": 60
    }
  },
  "saved_searches": {
    "phishing-inbound-1h": {
      "name": "phishing-inbound-1h",
      "query": "index=phishing status=reported earliest=-1h",
      "owner": "soc-agent-prod",
      "schedule": "@hourly"
    },
    "new-external-domains-1h": {
      "name": "new-external-domains-1h",
      "query": "index=dns domain_age_days<7 direction=egress earliest=-1h",
      "owner": "soc-agent-prod",
      "schedule": "@hourly"
    },
    "service-account-deviations-15m": {
      "name": "service-account-deviations-15m",
      "query": "index=auth user=svc-* deviation_sigma>3 earliest=-15m",
      "owner": "soc-agent-prod",
      "schedule": "*/15 * * * *"
    },
    "auth-failure-burst-5m": {
      "name": "auth-failure-burst-5m",
      "query": "index=auth result=failure | stats count by src_ip | where count>10",
      "owner": "soc-agent-prod",
      "schedule": "*/5 * * * *"
    },
    "vpn-impossible-travel-30m": {
      "name": "vpn-impossible-travel-30m",
      "query": "index=vpn | impossible_travel=true earliest=-30m",
      "owner": "soc-agent-prod",
      "schedule": "*/30 * * * *"
    }
  },
