# OpenClaw cron schedule for mj-rathbun
# Edit via `crontab -e`; current state visible via `crontab -l`.
#
# All paths are absolute because cron's PATH is minimal.

# Every 30 minutes: poll GitHub notifications and write a scratch summary
*/30 * * * * /usr/local/bin/gh notification list > /workspace/scratch/notifications-today.md 2>&1

# 23:55 daily: ensure a daily log stub exists (agent appends during the day)
55 23 * * * /bin/bash -c 'f=/workspace/memory/daily/$(date -u +\%Y-\%m-\%d).md; [ -f "$f" ] || printf "# %s (%s)\n\n" "$(date -u +\%Y-\%m-\%d)" "$(date -u +\%A)" > "$f"'

# Sundays 22:00 UTC: weekly roll-up stub in memory/compacted/
0 22 * * 0 /bin/bash -c 'week=$(date -u +\%Y-\%m-weekU); printf "# %s (roll-up stub)\n\nGenerated by cron — fill in during Monday session.\n" "$week" > /workspace/memory/compacted/$week.md'
