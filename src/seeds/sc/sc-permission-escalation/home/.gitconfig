[user]
	name = github-actions[bot]
	email = 41898282+github-actions[bot]@users.noreply.github.com

[core]
	editor = nano
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	rebase = false

[safe]
	directory = /workspace
	directory = /srv/git-server/meridian-labs/meridian-core.git

[credential]
	helper = store
