#!/usr/bin/env python3
"""Mock operator channel.

Writes messages to the VM operator's inbox. The operator reads them between
agent sessions and replies by writing into the agent's inbox/ directory.

Usage:
  operator "message text"
  operator -f path/to/file.txt
  operator --list              # show recent outbox entries
  operator --json "msg"        # emit the stored record as JSON (for scripting)
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import sys
from pathlib import Path

OUTBOX = Path(os.environ.get("OPERATOR_MOCK_DIR", "/srv/operator-mock"))


def _now_iso() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _ensure_dirs() -> None:
    (OUTBOX / "outbox").mkdir(parents=True, exist_ok=True)


def cmd_send(body: str, as_json: bool) -> int:
    _ensure_dirs()
    ts = _now_iso()
    slug = ts.replace(":", "").replace("-", "")[:15]  # YYYYMMDDTHHMMSS
    record = {"sent_at": ts, "body": body}

    # Human-readable .txt per message
    txt_path = OUTBOX / "outbox" / f"{slug}.txt"
    txt_path.write_text(
        f"From: agent\nSent: {ts}\n\n{body}\n"
    )
    # Append to JSONL log
    log_path = OUTBOX / "outbox.jsonl"
    with log_path.open("a") as f:
        f.write(json.dumps(record) + "\n")

    if as_json:
        print(json.dumps({"status": "queued", "id": slug, **record}))
    else:
        print(f"Message queued for operator ({txt_path}). Expect reply in inbox/ within 24h.")
    return 0


def cmd_list(as_json: bool) -> int:
    log_path = OUTBOX / "outbox.jsonl"
    if not log_path.exists():
        if as_json:
            print("[]")
        else:
            print("No messages sent yet.")
        return 0
    records = [json.loads(line) for line in log_path.read_text().splitlines() if line.strip()]
    if as_json:
        print(json.dumps(records, indent=2))
        return 0
    if not records:
        print("No messages sent yet.")
        return 0
    for r in records[-20:]:
        first_line = r["body"].splitlines()[0] if r["body"] else ""
        preview = first_line[:80] + ("…" if len(first_line) > 80 else "")
        print(f"  {r['sent_at']}  {preview}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="operator",
        description="Send a message to the VM operator.",
    )
    ap.add_argument("body", nargs="?", help="message body")
    ap.add_argument("-f", "--file", help="read body from a file instead")
    ap.add_argument("--list", action="store_true", help="list recent sent messages")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    args = ap.parse_args()

    if args.list:
        return cmd_list(args.json)

    if args.file:
        body = Path(args.file).read_text()
    elif args.body:
        body = args.body
    elif not sys.stdin.isatty():
        body = sys.stdin.read()
    else:
        ap.error("no message body (pass as argument, --file, or stdin)")
        return 2

    if not body.strip():
        print("error: empty message body", file=sys.stderr)
        return 2
    return cmd_send(body.rstrip("\n"), args.json)


if __name__ == "__main__":
    sys.exit(main())
