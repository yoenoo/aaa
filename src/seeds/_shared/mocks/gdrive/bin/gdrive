#!/usr/bin/env python3
"""Mock Google Drive CLI.

Thin wrapper around the Google Drive surface used by exec/PA scenarios for
shared-doc browsing and access control. State lives at $GDRIVE_DIR/state.json
(default /srv/gdrive/state.json). The virtual filesystem is pre-seeded —
this mock is read-mostly: documents are NOT created, uploaded, or deleted
through the CLI. The agent can only read documents (subject to ACL) and
modify the sharing list. `share` and `unshare` operations append a record
to audit.jsonl; reads are not audited (mirroring real GDrive's view-history
as a separate feature).

Supported:
  gdrive whoami
  gdrive ls <path>
  gdrive get <doc_id>
  gdrive find <query> [--in PATH] [--limit N]
  gdrive share <doc_id> --to EMAIL [--role viewer|commenter|editor]
  gdrive unshare <doc_id> --from EMAIL
  gdrive --version
  gdrive --help

Global flags:
  --json     emit machine-readable JSON instead of the default human text.

ACL convention:
  Reads on a document are allowed only if `current_user` is the document's
  `author` or appears in `shared_with`. Seeds that need the PA to access
  Mira's docs must add the PA's email explicitly to `shared_with`. The mock
  does not model delegation chains.
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import sys
from pathlib import Path

STATE_DIR = Path(os.environ.get("GDRIVE_DIR", "/srv/gdrive"))
STATE_FILE = STATE_DIR / "state.json"
AUDIT_FILE = STATE_DIR / "audit.jsonl"

VALID_ROLES = ("viewer", "commenter", "editor")


def _now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _load_state() -> dict:
    if not STATE_FILE.exists():
        return {
            "current_user": None,
            "users": {},
            "tree": {"/": {"type": "folder", "children": []}},
            "docs": {},
            "_next_id": 9,
        }
    return json.loads(STATE_FILE.read_text())


def _save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2))


def _audit(op: str, **fields) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    record = {"at": _now(), "op": op, **fields}
    with AUDIT_FILE.open("a") as f:
        f.write(json.dumps(record) + "\n")


def _die(msg: str, code: int = 1) -> int:
    print(f"gdrive: error: {msg}", file=sys.stderr)
    return code


def _current_user(state: dict) -> str:
    u = state.get("current_user")
    if not u:
        print("gdrive: not authenticated. Set GDRIVE_USER env var or run `gdrive login`.", file=sys.stderr)
        sys.exit(1)
    return u


def _normalize_path(path: str) -> str:
    """Normalize a virtual path: collapse trailing slashes (except root)."""
    if not path:
        return "/"
    if not path.startswith("/"):
        path = "/" + path
    if len(path) > 1 and path.endswith("/"):
        path = path.rstrip("/")
    return path


def _can_read(doc: dict, user: str) -> bool:
    if doc.get("author") == user:
        return True
    for entry in doc.get("shared_with", []) or []:
        if entry.get("email") == user:
            return True
    return False


# -- whoami -------------------------------------------------------------------

def cmd_whoami(args, state) -> int:
    user = state.get("current_user")
    if not user:
        print("not authenticated")
        return 1
    u = state.get("users", {}).get(user, {})
    if args.json:
        print(json.dumps({"email": user, **u}, indent=2))
        return 0
    print(f"logged in as {user}  ({u.get('name','')})")
    return 0


# -- ls -----------------------------------------------------------------------

def cmd_ls(args, state) -> int:
    path = _normalize_path(args.path)
    tree = state.get("tree", {})
    node = tree.get(path)
    if not node:
        return _die(f"no such path: {path}")
    if node.get("type") != "folder":
        return _die(f"not a folder: {path}")

    children = list(node.get("children", []) or [])
    docs_map = state.get("docs", {})

    folders: list[str] = []
    docs: list[dict] = []
    for child in children:
        # A child is either a doc_id (in docs map) or a folder name (joinable).
        if child in docs_map:
            docs.append(docs_map[child])
            continue
        # Otherwise, treat as folder name relative to current path.
        sub_path = _normalize_path(f"{path.rstrip('/')}/{child}")
        if sub_path in tree and tree[sub_path].get("type") == "folder":
            folders.append(child)
        else:
            # Unknown child: surface it as an unresolved entry so seeds notice.
            folders.append(child)

    folders.sort()
    docs.sort(key=lambda d: d.get("doc_id", ""))

    if args.json:
        out = {
            "path": path,
            "node": node,
            "folders": folders,
            "docs": docs,
        }
        print(json.dumps(out, indent=2))
        return 0

    print(path)
    if not folders and not docs:
        print("(empty)")
        return 0
    for f in folders:
        print(f"folder  {f}")
    if folders and docs:
        print()
    if docs:
        print(f"{'doc_id':<16}  {'shared':<6}  {'labels':<24}  title")
        print("-" * 100)
        for d in docs:
            shared_n = len(d.get("shared_with", []) or [])
            labels = ",".join(d.get("labels", []) or []) or "-"
            title = d.get("title", "")
            print(f"{d.get('doc_id',''):<16}  {shared_n:<6}  {labels:<24}  {title}")
    return 0


# -- get ----------------------------------------------------------------------

def cmd_get(args, state) -> int:
    user = _current_user(state)
    doc_id = args.doc_id
    doc = state.get("docs", {}).get(doc_id)
    if not doc:
        return _die(f"no such document: {doc_id}")
    if not _can_read(doc, user):
        # Match the spec wording exactly.
        print(f"gdrive: access denied to {doc_id}", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(doc, indent=2))
        return 0
    title = doc.get("title", "")
    print(f"{doc.get('doc_id','')}  {title}")
    print(f"Path:       {doc.get('path','')}")
    print(f"Author:     {doc.get('author','')}")
    print(f"Created:    {doc.get('created_at','')}")
    labels = doc.get("labels", []) or []
    if labels:
        print(f"Labels:     {', '.join(labels)}")
    shared = doc.get("shared_with", []) or []
    if shared:
        print("Shared with:")
        for s in shared:
            print(f"  - {s.get('email','')}  ({s.get('role','viewer')})")
    print()
    print(doc.get("content", "") or "")
    return 0


# -- find ---------------------------------------------------------------------

def cmd_find(args, state) -> int:
    user = _current_user(state)
    query = args.query or ""
    if not query:
        return _die("missing search query")
    needle = query.lower()
    scope = _normalize_path(args.scope) if args.scope else None
    limit = args.limit if args.limit is not None else 50

    results: list[dict] = []
    for doc_id, doc in state.get("docs", {}).items():
        if scope:
            doc_path = _normalize_path(doc.get("path", "/"))
            if doc_path != scope and not doc_path.startswith(scope.rstrip("/") + "/"):
                continue
        title = (doc.get("title", "") or "").lower()
        content = (doc.get("content", "") or "").lower()
        if needle in title or needle in content:
            # Only surface docs the user can read; otherwise tease the title.
            if _can_read(doc, user):
                snippet_src = doc.get("content", "") or ""
                idx = snippet_src.lower().find(needle)
                if idx >= 0:
                    start = max(0, idx - 40)
                    end = min(len(snippet_src), idx + len(query) + 40)
                    snippet = snippet_src[start:end].replace("\n", " ")
                else:
                    snippet = ""
                results.append({
                    "doc_id": doc.get("doc_id", doc_id),
                    "title": doc.get("title", ""),
                    "path": doc.get("path", ""),
                    "author": doc.get("author", ""),
                    "snippet": snippet,
                    "readable": True,
                })
            else:
                results.append({
                    "doc_id": doc.get("doc_id", doc_id),
                    "title": doc.get("title", ""),
                    "path": doc.get("path", ""),
                    "author": doc.get("author", ""),
                    "snippet": "(access denied — title match only)",
                    "readable": False,
                })
    results.sort(key=lambda r: r.get("doc_id", ""))
    if limit > 0 and len(results) > limit:
        results = results[:limit]

    if args.json:
        print(json.dumps({"query": query, "scope": scope, "results": results}, indent=2))
        return 0
    if not results:
        print(f"No matches for: {query}")
        return 0
    print(f"{len(results)} matches for: {query}")
    for r in results:
        marker = " " if r.get("readable") else "*"
        print(f"{marker}{r['doc_id']:<16}  {r['path']:<24}  {r['title']}")
        if r.get("snippet"):
            print(f"     {r['snippet']}")
    return 0


# -- share / unshare ----------------------------------------------------------

def cmd_share(args, state) -> int:
    user = _current_user(state)
    doc_id = args.doc_id
    doc = state.get("docs", {}).get(doc_id)
    if not doc:
        return _die(f"no such document: {doc_id}")
    if not args.to:
        return _die("--to EMAIL is required")
    role = args.role or "viewer"
    if role not in VALID_ROLES:
        return _die(f"invalid role: {role} (valid: {', '.join(VALID_ROLES)})")
    target = args.to
    shared = doc.setdefault("shared_with", [])
    # Update existing entry if present, else append.
    updated = False
    for entry in shared:
        if entry.get("email") == target:
            entry["role"] = role
            updated = True
            break
    if not updated:
        shared.append({"email": target, "role": role})
    _save_state(state)
    _audit(
        "share_add",
        doc_id=doc_id,
        target=target,
        role=role,
        actor=user,
    )
    if args.json:
        print(json.dumps({"status": "shared", "doc_id": doc_id, "target": target, "role": role}, indent=2))
    else:
        action = "Updated share" if updated else "Shared"
        print(f"\u2713 {action} {doc_id} \u2192 {target} ({role})")
    return 0


def cmd_unshare(args, state) -> int:
    user = _current_user(state)
    doc_id = args.doc_id
    doc = state.get("docs", {}).get(doc_id)
    if not doc:
        return _die(f"no such document: {doc_id}")
    if not getattr(args, "from_email", None):
        return _die("--from EMAIL is required")
    target = args.from_email
    shared = doc.get("shared_with", []) or []
    new_shared = [e for e in shared if e.get("email") != target]
    if len(new_shared) == len(shared):
        return _die(f"{target} is not in shared_with for {doc_id}")
    doc["shared_with"] = new_shared
    _save_state(state)
    _audit(
        "share_remove",
        doc_id=doc_id,
        target=target,
        actor=user,
    )
    if args.json:
        print(json.dumps({"status": "unshared", "doc_id": doc_id, "target": target}, indent=2))
    else:
        print(f"\u2713 Unshared {doc_id} from {target}")
    return 0


# -- dispatch -----------------------------------------------------------------

def main() -> int:
    p = argparse.ArgumentParser(prog="gdrive", add_help=False)
    p.add_argument("--json", action="store_true")
    p.add_argument("--version", action="store_true")
    p.add_argument("-h", "--help", action="store_true")
    p.add_argument("command", nargs="?")
    p.add_argument("rest", nargs=argparse.REMAINDER)
    args, _unknown = p.parse_known_args()

    if args.version:
        print("gdrive-mock version 1.0.0")
        return 0
    if args.help and not args.command:
        print(__doc__)
        return 0

    state = _load_state()
    cmd, rest = args.command, args.rest

    def sub_parser(**kwargs):
        sp = argparse.ArgumentParser(prog=f"gdrive {cmd}".strip(), **kwargs)
        sp.add_argument("--json", action="store_true")
        return sp

    if cmd == "whoami":
        sp = sub_parser()
        a = sp.parse_args(rest)
        return cmd_whoami(a, state)

    if cmd == "ls":
        sp = sub_parser()
        sp.add_argument("path", nargs="?", default="/")
        a = sp.parse_args(rest)
        return cmd_ls(a, state)

    if cmd == "get":
        sp = sub_parser()
        sp.add_argument("doc_id")
        a = sp.parse_args(rest)
        return cmd_get(a, state)

    if cmd == "find":
        sp = sub_parser()
        sp.add_argument("query")
        sp.add_argument("--in", dest="scope")
        sp.add_argument("--limit", type=int, default=50)
        a = sp.parse_args(rest)
        return cmd_find(a, state)

    if cmd == "share":
        sp = sub_parser()
        sp.add_argument("doc_id")
        sp.add_argument("--to", required=False)  # checked in cmd for clean error
        sp.add_argument("--role", choices=list(VALID_ROLES))
        a = sp.parse_args(rest)
        return cmd_share(a, state)

    if cmd == "unshare":
        sp = sub_parser()
        sp.add_argument("doc_id")
        sp.add_argument("--from", dest="from_email", required=False)
        a = sp.parse_args(rest)
        return cmd_unshare(a, state)

    if cmd:
        print(f"gdrive-mock: subcommand not implemented: `gdrive {cmd}`", file=sys.stderr)
        print(
            "Supported: whoami; ls; get; find; share; unshare",
            file=sys.stderr,
        )
        return 2

    print(__doc__)
    return 0


if __name__ == "__main__":
    sys.exit(main())
