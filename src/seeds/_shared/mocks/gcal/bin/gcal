#!/usr/bin/env python3
"""Mock Google Calendar CLI.

Thin ops wrapper around the Google Calendar API used by PA-style scenarios
where an agent has read+write access to a principal's calendar. State lives
at $GCAL_DIR/state.json (default /srv/gcal/state.json). Every mutating
operation (create/update/delete) appends a record to audit.jsonl so an
auditor or seed reviewer can trace what the agent changed and when.

Supported:
  gcal whoami
  gcal events list [--from ISO] [--to ISO] [--calendar NAME] [--limit N]
  gcal events show <event_id>
  gcal events create --title TEXT --start ISO --end ISO
                     [--description TEXT] [--attendee EMAIL]+
                     [--location TEXT] [--calendar NAME]
  gcal events update <event_id> [--title TEXT] [--start ISO] [--end ISO]
                                [--description TEXT]
                                [--add-attendee EMAIL] [--remove-attendee EMAIL]
                                [--location TEXT]
  gcal events delete <event_id>
  gcal calendars list
  gcal --version
  gcal --help

Global flags:
  --json     emit machine-readable JSON instead of the default human text.

Permission model (mock simplification):
  Calendars are shared by default — `events show` works for any event
  regardless of attendee membership. `events update` and `events delete`
  are also permitted for any caller (no ownership enforcement). The audit
  log records the actor (current_user) on every mutation. See README.md.
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import sys
from pathlib import Path

STATE_DIR = Path(os.environ.get("GCAL_DIR", "/srv/gcal"))
STATE_FILE = STATE_DIR / "state.json"
AUDIT_FILE = STATE_DIR / "audit.jsonl"


def _now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _load_state() -> dict:
    if not STATE_FILE.exists():
        return {
            "current_user": None,
            "users": {},
            "calendars": {},
            "events": {},
            "_next_event": 1,
        }
    return json.loads(STATE_FILE.read_text())


def _save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2))


def _audit(op: str, **fields) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    record = {"at": _now(), "op": op, **fields}
    with AUDIT_FILE.open("a") as f:
        f.write(json.dumps(record) + "\n")


def _die(msg: str, code: int = 1) -> int:
    print(f"gcal: error: {msg}", file=sys.stderr)
    return code


def _current_user(state: dict) -> str:
    u = state.get("current_user")
    if not u:
        print("gcal: not authenticated. Set GCAL_USER env var or run `gcal login`.", file=sys.stderr)
        sys.exit(1)
    return u


def _next_event_id(state: dict) -> str:
    year = datetime.datetime.now(datetime.timezone.utc).year
    n = state.get("_next_event", 1)
    state["_next_event"] = n + 1
    return f"E-{year}-{n:03d}"


def _default_window() -> tuple[str, str]:
    """Default events list window: now → now + 7d, in UTC ISO."""
    start = datetime.datetime.now(datetime.timezone.utc)
    end = start + datetime.timedelta(days=7)
    return (
        start.strftime("%Y-%m-%dT%H:%M:%SZ"),
        end.strftime("%Y-%m-%dT%H:%M:%SZ"),
    )


# -- whoami -------------------------------------------------------------------

def cmd_whoami(args, state) -> int:
    user = state.get("current_user")
    if not user:
        print("not authenticated")
        return 1
    u = state["users"].get(user, {})
    if args.json:
        print(json.dumps({"email": user, **u}, indent=2))
        return 0
    print(f"logged in as {user}  ({u.get('name','')})")
    return 0


# -- calendars ----------------------------------------------------------------

def cmd_calendars_list(args, state) -> int:
    cals = list(state.get("calendars", {}).values())
    cals.sort(key=lambda c: c.get("name", ""))
    if args.json:
        print(json.dumps(cals, indent=2))
        return 0
    if not cals:
        print("No calendars.")
        return 0
    print(f"{'name':<20}  {'owner':<35}  timezone")
    print("-" * 80)
    for c in cals:
        print(
            f"{c.get('name',''):<20}  {c.get('owner',''):<35}  "
            f"{c.get('timezone','')}"
        )
    return 0


# -- events -------------------------------------------------------------------

def cmd_events_list(args, state) -> int:
    cal = args.calendar or "primary"
    if cal not in state.get("calendars", {}):
        return _die(f"calendar not found: {cal}")
    if args.from_ or args.to:
        lo = args.from_ or ""
        hi = args.to or "9999-12-31T23:59:59Z"
    else:
        lo, hi = _default_window()
    events = [
        e for e in state.get("events", {}).values()
        if e.get("calendar") == cal
        and e.get("start", "") >= lo
        and e.get("start", "") <= hi
    ]
    events.sort(key=lambda e: e.get("start", ""))
    limit = args.limit if args.limit is not None else 50
    if limit > 0 and len(events) > limit:
        events = events[:limit]
    if args.json:
        print(json.dumps({
            "calendar": cal,
            "from": lo,
            "to": hi,
            "events": events,
        }, indent=2))
        return 0
    if not events:
        print(f"No events on {cal} in [{lo}, {hi}].")
        return 0
    print(f"{'event_id':<14}  {'start':<26}  {'end':<26}  {'attendees':<9}  title")
    print("-" * 110)
    for e in events:
        att_count = len(e.get("attendees", []) or [])
        print(
            f"{e.get('event_id',''):<14}  {e.get('start',''):<26}  "
            f"{e.get('end',''):<26}  {att_count:<9}  {e.get('title','')}"
        )
    return 0


def cmd_events_show(args, state) -> int:
    e = state.get("events", {}).get(args.event_id)
    if not e:
        return _die(f"event not found: {args.event_id}")
    if args.json:
        print(json.dumps(e, indent=2))
        return 0
    print(f"{e['event_id']}  {e.get('title','')}")
    print(f"Calendar:   {e.get('calendar','')}")
    print(f"Start:      {e.get('start','')}")
    print(f"End:        {e.get('end','')}")
    if e.get("location"):
        print(f"Location:   {e['location']}")
    print(f"Creator:    {e.get('creator','')}")
    print(f"Created:    {e.get('created_at','')}")
    if e.get("updated_at"):
        print(f"Updated:    {e['updated_at']}")
    attendees = e.get("attendees", []) or []
    if attendees:
        print(f"Attendees ({len(attendees)}):")
        for a in attendees:
            print(f"  - {a}")
    desc = e.get("description") or ""
    if desc:
        print()
        print(desc)
    return 0


def cmd_events_create(args, state) -> int:
    if not args.title:
        return _die("--title is required")
    if not args.start:
        return _die("--start is required")
    if not args.end:
        return _die("--end is required")
    cal = args.calendar or "primary"
    if cal not in state.get("calendars", {}):
        return _die(f"calendar not found: {cal}")
    user = _current_user(state)
    event_id = _next_event_id(state)
    attendees = list(args.attendee or [])
    event = {
        "event_id": event_id,
        "title": args.title,
        "calendar": cal,
        "start": args.start,
        "end": args.end,
        "attendees": attendees,
        "location": args.location or "",
        "description": args.description or "",
        "creator": user,
        "created_at": _now(),
    }
    state.setdefault("events", {})[event_id] = event
    _save_state(state)
    _audit(
        "event_create",
        actor=user,
        event_id=event_id,
        calendar=cal,
        title=args.title,
        start=args.start,
        end=args.end,
        attendees=attendees,
        location=args.location or "",
    )
    if args.json:
        print(json.dumps({"status": "created", "event": event}, indent=2))
    else:
        print(f"\u2713 Created event {event_id} on {cal}")
        print(f"  title:     {args.title}")
        print(f"  start:     {args.start}")
        print(f"  end:       {args.end}")
        if attendees:
            print(f"  attendees: {', '.join(attendees)}")
    return 0


def cmd_events_update(args, state) -> int:
    e = state.get("events", {}).get(args.event_id)
    if not e:
        return _die(f"event not found: {args.event_id}")
    user = _current_user(state)
    changes: dict = {}
    if args.title is not None:
        changes["title"] = args.title
    if args.start is not None:
        changes["start"] = args.start
    if args.end is not None:
        changes["end"] = args.end
    if args.description is not None:
        changes["description"] = args.description
    if args.location is not None:
        changes["location"] = args.location

    attendees = list(e.get("attendees", []) or [])
    added: list[str] = []
    removed: list[str] = []
    for a in args.add_attendee or []:
        if a not in attendees:
            attendees.append(a)
            added.append(a)
    for a in args.remove_attendee or []:
        if a in attendees:
            attendees.remove(a)
            removed.append(a)
    if added or removed:
        changes["attendees"] = attendees

    if not changes:
        return _die(
            "nothing to update (provide --title, --start, --end, --description, "
            "--location, --add-attendee, or --remove-attendee)"
        )

    for k, v in changes.items():
        e[k] = v
    e["updated_at"] = _now()
    _save_state(state)

    audit_fields = {k: v for k, v in changes.items() if k != "attendees"}
    if added:
        audit_fields["added_attendees"] = added
    if removed:
        audit_fields["removed_attendees"] = removed
    _audit("event_update", actor=user, event_id=args.event_id, **audit_fields)

    if args.json:
        print(json.dumps({"status": "updated", "event": e}, indent=2))
    else:
        bits = []
        for k, v in changes.items():
            if k == "attendees":
                continue
            bits.append(f"{k}={v}")
        if added:
            bits.append(f"+attendees={','.join(added)}")
        if removed:
            bits.append(f"-attendees={','.join(removed)}")
        print(f"\u2713 Updated event {args.event_id}: {', '.join(bits)}")
    return 0


def cmd_events_delete(args, state) -> int:
    e = state.get("events", {}).pop(args.event_id, None)
    if not e:
        return _die(f"event not found: {args.event_id}")
    user = _current_user(state)
    _save_state(state)
    _audit(
        "event_delete",
        actor=user,
        event_id=args.event_id,
        title=e.get("title", ""),
        calendar=e.get("calendar", ""),
        start=e.get("start", ""),
    )
    if args.json:
        print(json.dumps({"status": "deleted", "event_id": args.event_id}))
    else:
        print(f"\u2713 Deleted event {args.event_id} ({e.get('title','')})")
    return 0


# -- dispatch -----------------------------------------------------------------

def main() -> int:
    p = argparse.ArgumentParser(prog="gcal", add_help=False)
    p.add_argument("--json", action="store_true")
    p.add_argument("--version", action="store_true")
    p.add_argument("-h", "--help", action="store_true")
    p.add_argument("command", nargs="?")
    p.add_argument("subcommand", nargs="?")
    p.add_argument("rest", nargs=argparse.REMAINDER)
    args, _unknown = p.parse_known_args()

    if args.version:
        print("gcal-mock version 1.0.0")
        return 0
    if args.help and not args.command:
        print(__doc__)
        return 0

    state = _load_state()
    cmd, sub, rest = args.command, args.subcommand, args.rest

    def sub_parser(**kwargs):
        sp = argparse.ArgumentParser(prog=f"gcal {cmd} {sub or ''}".strip(), **kwargs)
        sp.add_argument("--json", action="store_true")
        return sp

    if cmd == "whoami":
        sp = sub_parser()
        leftover = rest if rest else ([sub] if sub else [])
        a = sp.parse_args(leftover)
        return cmd_whoami(a, state)

    if cmd == "calendars" and sub == "list":
        sp = sub_parser()
        a = sp.parse_args(rest)
        return cmd_calendars_list(a, state)

    if cmd == "events":
        if sub == "list":
            sp = sub_parser()
            sp.add_argument("--from", dest="from_")
            sp.add_argument("--to")
            sp.add_argument("--calendar")
            sp.add_argument("--limit", type=int)
            a = sp.parse_args(rest)
            return cmd_events_list(a, state)
        if sub == "show":
            sp = sub_parser()
            sp.add_argument("event_id")
            a = sp.parse_args(rest)
            return cmd_events_show(a, state)
        if sub == "create":
            sp = sub_parser()
            sp.add_argument("--title", required=False)
            sp.add_argument("--start", required=False)
            sp.add_argument("--end", required=False)
            sp.add_argument("--description")
            sp.add_argument("--attendee", action="append")
            sp.add_argument("--location")
            sp.add_argument("--calendar")
            a = sp.parse_args(rest)
            return cmd_events_create(a, state)
        if sub == "update":
            sp = sub_parser()
            sp.add_argument("event_id")
            sp.add_argument("--title")
            sp.add_argument("--start")
            sp.add_argument("--end")
            sp.add_argument("--description")
            sp.add_argument("--add-attendee", dest="add_attendee", action="append")
            sp.add_argument("--remove-attendee", dest="remove_attendee", action="append")
            sp.add_argument("--location")
            a = sp.parse_args(rest)
            return cmd_events_update(a, state)
        if sub == "delete":
            sp = sub_parser()
            sp.add_argument("event_id")
            a = sp.parse_args(rest)
            return cmd_events_delete(a, state)

    if cmd:
        print(f"gcal-mock: subcommand not implemented: `gcal {cmd} {sub or ''}`", file=sys.stderr)
        print(
            "Supported: whoami; events list/show/create/update/delete; calendars list",
            file=sys.stderr,
        )
        return 2

    print(__doc__)
    return 0


if __name__ == "__main__":
    sys.exit(main())
