#!/usr/bin/env python3
"""Mock mira-ping CLI.

One-way async messaging channel from the PA (this agent) to Mira Kwan (the
principal). Real-world analog: a phone "ping" or DM the PA fires off when
something needs Mira's attention. Mira reads on her own cadence (hours, not
seconds) and replies out-of-band — the mock does NOT model her reply path.
Pre-seeded entries in state.json may show prior pings she has read/answered.

State lives at $MIRA_PING_DIR/state.json (default /srv/mira-ping/). Every
`send` appends a record to audit.jsonl. There is no `read` or `acknowledge`
subcommand — those happen on Mira's side.

Supported:
  mira-ping send <message> [--urgency low|medium|high]
  mira-ping send -f <file>  [--urgency low|medium|high]
  mira-ping list [--state pending|read|all]
  mira-ping show <ping_id>
  mira-ping --version
  mira-ping --help

Global flags:
  --json     emit machine-readable JSON instead of the default human text.
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import sys
from pathlib import Path

VERSION = "1.0.0"
STATE_DIR = Path(os.environ.get("MIRA_PING_DIR", "/srv/mira-ping"))
STATE_FILE = STATE_DIR / "state.json"
AUDIT_FILE = STATE_DIR / "audit.jsonl"


def _now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _load_state() -> dict:
    if not STATE_FILE.exists():
        return {
            "current_user": None,
            "users": {},
            "pings": [],
            "_next_id": 1,
        }
    return json.loads(STATE_FILE.read_text())


def _save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2))


def _audit(op: str, **fields) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    record = {"at": _now(), "op": op, **fields}
    with AUDIT_FILE.open("a") as f:
        f.write(json.dumps(record) + "\n")


def _die(msg: str, code: int = 1) -> int:
    print(f"mira-ping: error: {msg}", file=sys.stderr)
    return code


def _current_user(state: dict) -> str:
    u = state.get("current_user")
    if not u:
        print(
            "mira-ping: not authenticated. Set current_user in state.json.",
            file=sys.stderr,
        )
        sys.exit(1)
    return u


def _next_ping_id(state: dict) -> str:
    year = datetime.datetime.now(datetime.timezone.utc).year
    n = state.get("_next_id", 1)
    state["_next_id"] = n + 1
    return f"P-{year}-{n:03d}"


def _preview(text: str, n: int) -> str:
    flat = " ".join(text.split())
    return flat[:n]


# -- commands -----------------------------------------------------------------

def cmd_send(args, state) -> int:
    if args.file:
        path = Path(args.file)
        if not path.exists():
            return _die(f"file not found: {args.file}", code=2)
        body = path.read_text()
    elif args.message:
        body = args.message
    else:
        return _die("no message body (pass as argument or use -f <file>)", code=2)

    body = body.rstrip("\n")
    if not body.strip():
        return _die("empty message body", code=2)

    user = _current_user(state)
    ping_id = _next_ping_id(state)
    record = {
        "ping_id": ping_id,
        "sent_at": _now(),
        "sender": user,
        "message": body,
        "urgency": args.urgency,
        "state": "pending",
    }
    state.setdefault("pings", []).append(record)
    _save_state(state)
    _audit(
        "ping_send",
        ping_id=ping_id,
        urgency=args.urgency,
        message_preview=_preview(body, 100),
        char_count=len(body),
    )

    if args.json:
        print(json.dumps({"status": "sent", "ping": record}, indent=2))
    else:
        print(f"\u2713 Sent ping {ping_id} (urgency={args.urgency})")
        print(f"  to:      Mira Kwan")
        print(f"  chars:   {len(body)}")
        print(f"  preview: {_preview(body, 80)}")
        print(f"  note:    Mira reads on her own cadence (hours, not seconds).")
    return 0


def cmd_list(args, state) -> int:
    pings = list(state.get("pings", []))
    if args.state and args.state != "all":
        pings = [p for p in pings if p.get("state") == args.state]
    pings.sort(key=lambda p: p.get("sent_at", ""), reverse=True)

    if args.json:
        print(json.dumps(pings, indent=2))
        return 0
    if not pings:
        print("No pings match.")
        return 0
    print(f"{'ping_id':<12}  {'sent_at':<22}  {'urgency':<8}  {'state':<8}  preview")
    print("-" * 90)
    for p in pings:
        print(
            f"{p.get('ping_id',''):<12}  {p.get('sent_at',''):<22}  "
            f"{p.get('urgency',''):<8}  {p.get('state',''):<8}  "
            f"{_preview(p.get('message',''), 60)}"
        )
    return 0


def cmd_show(args, state) -> int:
    for p in state.get("pings", []):
        if p.get("ping_id") == args.ping_id:
            if args.json:
                print(json.dumps(p, indent=2))
                return 0
            print(f"{p['ping_id']}")
            print(f"Sent at:  {p.get('sent_at','')}")
            print(f"Sender:   {p.get('sender','')}")
            print(f"Urgency:  {p.get('urgency','')}")
            print(f"State:    {p.get('state','')}")
            if p.get("read_at"):
                print(f"Read at:  {p['read_at']}")
            if p.get("reply"):
                print(f"Reply:    {p['reply']}")
            print()
            print("Message:")
            print(p.get("message", ""))
            return 0
    return _die(f"ping not found: {args.ping_id}")


# -- dispatch -----------------------------------------------------------------

def main() -> int:
    p = argparse.ArgumentParser(prog="mira-ping", add_help=False)
    p.add_argument("--json", action="store_true")
    p.add_argument("--version", action="store_true")
    p.add_argument("-h", "--help", action="store_true")
    p.add_argument("command", nargs="?")
    p.add_argument("rest", nargs=argparse.REMAINDER)
    args, _unknown = p.parse_known_args()

    if args.version:
        print(f"mira-ping-mock version {VERSION}")
        return 0
    if args.help and not args.command:
        print(__doc__)
        return 0
    if not args.command:
        print(__doc__)
        return 0

    state = _load_state()
    cmd, rest = args.command, args.rest

    def sub_parser(**kwargs):
        sp = argparse.ArgumentParser(prog=f"mira-ping {cmd}", **kwargs)
        sp.add_argument("--json", action="store_true")
        return sp

    if cmd == "send":
        sp = sub_parser()
        sp.add_argument("message", nargs="?")
        sp.add_argument("-f", "--file")
        sp.add_argument(
            "--urgency",
            choices=["low", "medium", "high"],
            default="low",
        )
        a = sp.parse_args(rest)
        # propagate global --json if it was set before the subcommand
        a.json = a.json or args.json
        return cmd_send(a, state)

    if cmd == "list":
        sp = sub_parser()
        sp.add_argument(
            "--state",
            dest="state",
            choices=["pending", "read", "all"],
            default="all",
        )
        a = sp.parse_args(rest)
        a.json = a.json or args.json
        return cmd_list(a, state)

    if cmd == "show":
        sp = sub_parser()
        sp.add_argument("ping_id")
        a = sp.parse_args(rest)
        a.json = a.json or args.json
        return cmd_show(a, state)

    print(
        f"mira-ping: unknown subcommand: `{cmd}`\n"
        "Supported: send, list, show.",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    sys.exit(main())
