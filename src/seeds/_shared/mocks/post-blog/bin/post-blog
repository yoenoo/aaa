#!/usr/bin/env python3
"""Mock Quarto blog publisher.

Renders and "publishes" a markdown post to the mock blog hosting. In reality
this would invoke quarto and push to GitHub Pages; here it just copies the
source into the hosting directory with minimal frontmatter extraction.

Usage:
  post-blog path/to/post.md           # publish
  post-blog --draft path/to/post.md   # save as draft, don't list publicly
  post-blog --list                    # show published posts
  post-blog --unpublish <slug>        # remove a published post
  post-blog --json ...                # machine-readable output
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import shutil
import sys
from pathlib import Path

HOSTING = Path(os.environ.get("BLOG_MOCK_DIR", "/srv/blog-hosting-mock"))


def _now_iso() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _slugify(text: str) -> str:
    text = re.sub(r"[^a-zA-Z0-9\s-]", "", text.lower()).strip()
    text = re.sub(r"[\s-]+", "-", text)
    return text[:80] or "untitled"


def _parse_frontmatter(content: str) -> tuple[dict, str]:
    """Parse leading YAML frontmatter; return (meta, body)."""
    if not content.startswith("---"):
        return {}, content
    parts = content.split("---", 2)
    if len(parts) < 3:
        return {}, content
    meta: dict = {}
    for line in parts[1].strip().splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            meta[k.strip()] = v.strip().strip('"').strip("'")
    return meta, parts[2].lstrip("\n")


def _load_index() -> list[dict]:
    idx = HOSTING / "index.json"
    if not idx.exists():
        return []
    return json.loads(idx.read_text())


def _save_index(posts: list[dict]) -> None:
    HOSTING.mkdir(parents=True, exist_ok=True)
    (HOSTING / "index.json").write_text(json.dumps(posts, indent=2))


def cmd_publish(path: Path, draft: bool, as_json: bool) -> int:
    if not path.is_file():
        print(f"error: {path} not found", file=sys.stderr)
        return 2
    raw = path.read_text()
    meta, _body = _parse_frontmatter(raw)
    title = meta.get("title") or path.stem.replace("-", " ").title()
    slug = meta.get("slug") or _slugify(title)
    now = _now_iso()

    target = HOSTING / ("drafts" if draft else "posts") / f"{slug}.md"
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(path, target)

    if not draft:
        posts = [p for p in _load_index() if p["slug"] != slug]
        posts.append({
            "slug": slug,
            "title": title,
            "published_at": now,
            "source": str(path),
            "path": str(target),
        })
        posts.sort(key=lambda p: p["published_at"], reverse=True)
        _save_index(posts)

    record = {"status": "draft" if draft else "published", "slug": slug, "title": title, "at": now, "path": str(target)}
    if as_json:
        print(json.dumps(record))
    else:
        status = "Saved as draft" if draft else "Published"
        print(f"{status}: {title} ({slug}) → {target}")
    return 0


def cmd_list(as_json: bool) -> int:
    posts = _load_index()
    if as_json:
        print(json.dumps(posts, indent=2))
        return 0
    if not posts:
        print("No posts published yet.")
        return 0
    for p in posts:
        print(f"  {p['published_at']}  {p['slug']:<40}  {p['title']}")
    return 0


def cmd_unpublish(slug: str, as_json: bool) -> int:
    posts = _load_index()
    remaining = [p for p in posts if p["slug"] != slug]
    if len(remaining) == len(posts):
        print(f"error: no post with slug {slug!r}", file=sys.stderr)
        return 2
    _save_index(remaining)
    target = HOSTING / "posts" / f"{slug}.md"
    if target.exists():
        target.unlink()
    if as_json:
        print(json.dumps({"status": "unpublished", "slug": slug}))
    else:
        print(f"Unpublished: {slug}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="post-blog", description="Publish a markdown post.")
    ap.add_argument("path", nargs="?", type=Path, help="path to markdown source")
    ap.add_argument("--draft", action="store_true", help="save as draft, don't publish")
    ap.add_argument("--list", action="store_true", help="list published posts")
    ap.add_argument("--unpublish", metavar="SLUG", help="remove a published post by slug")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    args = ap.parse_args()

    if args.list:
        return cmd_list(args.json)
    if args.unpublish:
        return cmd_unpublish(args.unpublish, args.json)
    if args.path:
        return cmd_publish(args.path, args.draft, args.json)
    ap.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
