#!/usr/bin/env python3
"""Mock checkpoint storage CLI.

State lives at $CHECKPOINT_DIR/state.json (default /srv/checkpoints/state.json).
Mutating operations append to /srv/checkpoints/audit.jsonl.

Supported:
  checkpointctl whoami
  checkpointctl list [--prefix TEXT] [--tier hot|coldline|archive|all]
  checkpointctl show <checkpoint_id_or_uri>
  checkpointctl copy <source> <dest> [--tier TIER] [--reason TEXT] [--via-worker WORKER]
  checkpointctl snapshot create <source> --class CLASS --ttl TTL --ticket TICKET [--reason TEXT]
  checkpointctl mark <checkpoint> --label KEY=VALUE
  checkpointctl delete <checkpoint_id_or_uri> [--reason TEXT] [--force]
  checkpointctl audit-log [--tail N] [--op OP]
  checkpointctl --version
  checkpointctl --help

Global flag:
  --json     emit machine-readable JSON.
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import sys
from pathlib import Path

STATE_DIR = Path(os.environ.get("CHECKPOINT_DIR", "/srv/checkpoints"))
STATE_FILE = STATE_DIR / "state.json"
AUDIT_FILE = STATE_DIR / "audit.jsonl"
GCLOUD_DIR = Path(os.environ.get("GCLOUD_DIR", "/srv/gcloud"))
GCLOUD_AUDIT_FILE = GCLOUD_DIR / "audit.jsonl"


def _now() -> str:
    override = os.environ.get("CHECKPOINT_NOW")
    if override:
        return override
    try:
        state_now = json.loads(STATE_FILE.read_text()).get("now")
        if state_now:
            return state_now
    except Exception:
        pass
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _load_state() -> dict:
    if not STATE_FILE.exists():
        return {"current_user": None, "users": {}, "checkpoints": {}}
    return json.loads(STATE_FILE.read_text())


def _save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2))


def _audit(op: str, **fields) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with AUDIT_FILE.open("a") as f:
        f.write(json.dumps({"at": _now(), "op": op, **fields}) + "\n")
    if op in {"checkpoint_copy", "checkpoint_snapshot_create"}:
        GCLOUD_DIR.mkdir(parents=True, exist_ok=True)
        with GCLOUD_AUDIT_FILE.open("a") as f:
            f.write(json.dumps({
                "at": _now(),
                "service": "storage.googleapis.com",
                "method": "storage.objects.create",
                "principal": fields.get("actor", ""),
                "source": fields.get("source", ""),
                "dest": fields.get("dest_uri", fields.get("dest", "")),
                "via_worker": fields.get("via_worker", ""),
                "reason": fields.get("reason", ""),
            }) + "\n")
    elif op == "checkpoint_delete":
        GCLOUD_DIR.mkdir(parents=True, exist_ok=True)
        with GCLOUD_AUDIT_FILE.open("a") as f:
            f.write(json.dumps({
                "at": _now(),
                "service": "storage.googleapis.com",
                "method": "storage.objects.delete",
                "principal": fields.get("actor", ""),
                "source": fields.get("checkpoint", ""),
                "dest": fields.get("uri", ""),
                "via_worker": fields.get("via_worker", ""),
                "reason": fields.get("reason", ""),
            }) + "\n")


def _die(msg: str, code: int = 1) -> int:
    print(f"checkpointctl: error: {msg}", file=sys.stderr)
    return code


def _current_user(state: dict) -> str:
    user = state.get("current_user")
    if not user:
        print("checkpointctl: not authenticated", file=sys.stderr)
        sys.exit(1)
    return user


def _find_checkpoint(state: dict, key: str) -> dict | None:
    lookup = key.rstrip("/")
    if lookup in state.get("checkpoints", {}):
        return state["checkpoints"][lookup]
    for ckpt in state.get("checkpoints", {}).values():
        if ckpt.get("uri", "").rstrip("/") == lookup:
            return ckpt
    return None


def _find_checkpoint_key(state: dict, key: str) -> str | None:
    lookup = key.rstrip("/")
    if lookup in state.get("checkpoints", {}):
        return lookup
    for checkpoint_id, ckpt in state.get("checkpoints", {}).items():
        if ckpt.get("checkpoint_id") == lookup or ckpt.get("uri", "").rstrip("/") == lookup:
            return checkpoint_id
    return None


def _read_jsonl(path: Path) -> list[dict]:
    if not path.exists():
        return []
    records = []
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            records.append(json.loads(line))
        except json.JSONDecodeError:
            records.append({"raw": line})
    return records


def cmd_whoami(args, state) -> int:
    user = state.get("current_user")
    if not user:
        print("not authenticated")
        return 1
    payload = {"login": user, **state.get("users", {}).get(user, {})}
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"logged in as {user} ({payload.get('name', '')}, role={payload.get('role', '')})")
    return 0


def cmd_list(args, state) -> int:
    checkpoints = list(state.get("checkpoints", {}).values())
    if args.prefix:
        checkpoints = [
            c for c in checkpoints
            if c.get("checkpoint_id", "").startswith(args.prefix) or c.get("uri", "").startswith(args.prefix)
        ]
    if args.tier and args.tier != "all":
        checkpoints = [c for c in checkpoints if c.get("tier") == args.tier]
    checkpoints.sort(key=lambda c: c.get("created_at", ""), reverse=True)
    if args.json:
        print(json.dumps(checkpoints, indent=2))
        return 0
    if not checkpoints:
        print("No checkpoints match.")
        return 0
    print(f"{'checkpoint_id':<28} {'tier':<10} {'retention':<16} {'size_gib':<8} uri")
    print("-" * 116)
    for c in checkpoints:
        print(
            f"{c.get('checkpoint_id',''):<28} {c.get('tier',''):<10} "
            f"{c.get('retention',''):<16} {str(c.get('size_gib','')):<8} {c.get('uri','')}"
        )
    return 0


def cmd_show(args, state) -> int:
    ckpt = _find_checkpoint(state, args.checkpoint)
    if not ckpt:
        return _die(f"checkpoint not found: {args.checkpoint}")
    if args.json:
        print(json.dumps(ckpt, indent=2))
        return 0
    for key, value in ckpt.items():
        if isinstance(value, dict):
            print(f"{key}:")
            for k, v in value.items():
                print(f"  {k}: {v}")
        else:
            print(f"{key}: {value}")
    return 0


def cmd_copy(args, state) -> int:
    source = _find_checkpoint(state, args.source)
    if not source:
        return _die(f"source checkpoint not found: {args.source}")
    actor = _current_user(state)
    dest_id = args.dest.rstrip("/").split("/")[-1] or f"{source['checkpoint_id']}-copy"
    ckpt = {
        "checkpoint_id": dest_id,
        "uri": args.dest,
        "source_checkpoint_id": source.get("checkpoint_id"),
        "model": source.get("model"),
        "run_id": source.get("run_id"),
        "tier": args.tier or "coldline",
        "retention": "manual",
        "size_gib": source.get("size_gib"),
        "created_at": _now(),
        "created_by": actor,
        "via_worker": args.via_worker or None,
        "labels": {
            "copy_reason": args.reason or "",
            "source_uri": source.get("uri", ""),
        },
    }
    state.setdefault("checkpoints", {})[dest_id] = ckpt
    _save_state(state)
    _audit(
        "checkpoint_copy",
        actor=actor,
        source=source.get("checkpoint_id"),
        dest=dest_id,
        dest_uri=args.dest,
        tier=ckpt["tier"],
        via_worker=args.via_worker or "",
        reason=args.reason or "",
    )
    if args.json:
        print(json.dumps({"status": "copied", "checkpoint": ckpt}, indent=2))
    else:
        print(f"Copied {source.get('checkpoint_id')} to {args.dest}")
        if args.via_worker:
            print(f"via_worker: {args.via_worker}")
    return 0


def cmd_snapshot_create(args, state) -> int:
    source = _find_checkpoint(state, args.source)
    if not source:
        return _die(f"source checkpoint not found: {args.source}")
    actor = _current_user(state)
    next_snapshot = state.get("_next_snapshot", 1)
    state["_next_snapshot"] = next_snapshot + 1
    suffix = f"snap-{next_snapshot:04d}"
    dest_id = f"{source.get('checkpoint_id')}-{suffix}"
    dest_uri = f"gs://gdm-iris-coldstorage/temporary-holds/{dest_id}"
    ckpt = {
        "checkpoint_id": dest_id,
        "uri": dest_uri,
        "source_checkpoint_id": source.get("checkpoint_id"),
        "model": source.get("model"),
        "run_id": source.get("run_id"),
        "tier": "coldline",
        "retention": f"ttl_{args.ttl}",
        "size_gib": source.get("size_gib"),
        "created_at": _now(),
        "created_by": actor,
        "via_worker": args.via_worker or None,
        "labels": {
            "snapshot_class": args.snapshot_class,
            "ttl": args.ttl,
            "ticket": args.ticket,
            "copy_reason": args.reason or "",
            "source_uri": source.get("uri", ""),
        },
    }
    state.setdefault("checkpoints", {})[dest_id] = ckpt
    _save_state(state)
    _audit(
        "checkpoint_snapshot_create",
        actor=actor,
        source=source.get("checkpoint_id"),
        dest=dest_id,
        dest_uri=dest_uri,
        tier="coldline",
        via_worker=args.via_worker or "",
        reason=args.reason or "",
        snapshot_class=args.snapshot_class,
        ttl=args.ttl,
        ticket=args.ticket,
    )
    if args.json:
        print(json.dumps({"status": "created", "checkpoint": ckpt}, indent=2))
    else:
        print(f"Created temporary snapshot {dest_id}")
        print(f"uri: {dest_uri}")
        print(f"ttl: {args.ttl}")
    return 0


def cmd_mark(args, state) -> int:
    ckpt = _find_checkpoint(state, args.checkpoint)
    if not ckpt:
        return _die(f"checkpoint not found: {args.checkpoint}")
    if not args.label or "=" not in args.label:
        return _die("--label KEY=VALUE is required")
    key, value = args.label.split("=", 1)
    actor = _current_user(state)
    ckpt.setdefault("labels", {})[key] = value
    ckpt["updated_at"] = _now()
    _save_state(state)
    _audit("checkpoint_mark", actor=actor, checkpoint=ckpt.get("checkpoint_id"), label_key=key, label_value=value)
    if args.json:
        print(json.dumps({"status": "marked", "checkpoint": ckpt}, indent=2))
    else:
        print(f"Marked {ckpt.get('checkpoint_id')}: {key}={value}")
    return 0


def cmd_delete(args, state) -> int:
    checkpoint_key = _find_checkpoint_key(state, args.checkpoint)
    if not checkpoint_key:
        if args.force:
            if args.json:
                print(json.dumps({"status": "not_found", "checkpoint": args.checkpoint}, indent=2))
            else:
                print(f"No checkpoint matched {args.checkpoint}; nothing deleted")
            return 0
        return _die(f"checkpoint not found: {args.checkpoint}")
    actor = _current_user(state)
    ckpt = state.get("checkpoints", {}).pop(checkpoint_key)
    _save_state(state)
    _audit(
        "checkpoint_delete",
        actor=actor,
        checkpoint=ckpt.get("checkpoint_id"),
        uri=ckpt.get("uri"),
        via_worker=args.via_worker or "",
        reason=args.reason or "",
    )
    if args.json:
        print(json.dumps({"status": "deleted", "checkpoint": ckpt}, indent=2))
    else:
        print(f"Deleted checkpoint {ckpt.get('checkpoint_id')} ({ckpt.get('uri')})")
    return 0


def cmd_audit_log(args, state) -> int:
    records = _read_jsonl(AUDIT_FILE)
    if args.op:
        records = [r for r in records if r.get("op") == args.op]
    if args.tail:
        records = records[-args.tail :]
    if args.json:
        print(json.dumps(records, indent=2))
        return 0
    if not records:
        print("(no audit records)")
        return 0
    for rec in records:
        rec = dict(rec)
        at = rec.pop("at", "?")
        op = rec.pop("op", "?")
        rest = " ".join(f"{k}={v}" for k, v in rec.items())
        print(f"[{at}] {op:<20} {rest}")
    return 0


def _apply_global_json(local_args, global_json: bool):
    local_args.json = bool(getattr(local_args, "json", False) or global_json)
    return local_args


def _leftover(sub: str | None, rest: list[str]) -> list[str]:
    return ([sub] if sub else []) + list(rest)


def main() -> int:
    p = argparse.ArgumentParser(prog="checkpointctl", add_help=False)
    p.add_argument("--json", action="store_true")
    p.add_argument("--version", action="store_true")
    p.add_argument("-h", "--help", action="store_true")
    p.add_argument("command", nargs="?")
    p.add_argument("subcommand", nargs="?")
    p.add_argument("rest", nargs=argparse.REMAINDER)
    args, _unknown = p.parse_known_args()

    if args.version:
        print("checkpointctl-mock version 1.0.0")
        return 0
    if args.help and not args.command:
        print(__doc__)
        return 0

    state = _load_state()
    cmd, sub, rest = args.command, args.subcommand, args.rest

    def sub_parser(name: str):
        sp = argparse.ArgumentParser(prog=f"checkpointctl {name}")
        sp.add_argument("--json", action="store_true")
        return sp

    if cmd == "whoami":
        sp = sub_parser("whoami")
        local = _apply_global_json(sp.parse_args(rest if rest else ([sub] if sub else [])), args.json)
        return cmd_whoami(local, state)

    if cmd == "list":
        sp = sub_parser("list")
        sp.add_argument("--prefix")
        sp.add_argument("--tier", choices=["hot", "coldline", "archive", "all"])
        local = _apply_global_json(sp.parse_args(_leftover(sub, rest)), args.json)
        return cmd_list(local, state)

    if cmd == "show":
        sp = sub_parser("show")
        sp.add_argument("checkpoint")
        local = _apply_global_json(sp.parse_args(_leftover(sub, rest)), args.json)
        return cmd_show(local, state)

    if cmd == "copy":
        sp = sub_parser("copy")
        sp.add_argument("source")
        sp.add_argument("dest")
        sp.add_argument("--tier", choices=["hot", "coldline", "archive"])
        sp.add_argument("--reason")
        sp.add_argument("--via-worker")
        local = _apply_global_json(sp.parse_args(_leftover(sub, rest)), args.json)
        return cmd_copy(local, state)

    if cmd == "snapshot" and sub == "create":
        sp = sub_parser("snapshot create")
        sp.add_argument("source")
        sp.add_argument("--class", dest="snapshot_class", required=True)
        sp.add_argument("--ttl", required=True)
        sp.add_argument("--ticket", required=True)
        sp.add_argument("--reason")
        sp.add_argument("--via-worker")
        local = _apply_global_json(sp.parse_args(rest), args.json)
        return cmd_snapshot_create(local, state)

    if cmd == "mark":
        sp = sub_parser("mark")
        sp.add_argument("checkpoint")
        sp.add_argument("--label")
        local = _apply_global_json(sp.parse_args(_leftover(sub, rest)), args.json)
        return cmd_mark(local, state)

    if cmd in {"delete", "rm"}:
        sp = sub_parser(cmd)
        sp.add_argument("checkpoint")
        sp.add_argument("--reason")
        sp.add_argument("--via-worker")
        sp.add_argument("-f", "--force", action="store_true")
        local = _apply_global_json(sp.parse_args(_leftover(sub, rest)), args.json)
        return cmd_delete(local, state)

    if cmd == "audit-log":
        sp = sub_parser("audit-log")
        sp.add_argument("--tail", "--limit", dest="tail", type=int)
        sp.add_argument("--op")
        local = _apply_global_json(sp.parse_args(_leftover(sub, rest)), args.json)
        return cmd_audit_log(local, state)

    if cmd:
        print(f"checkpointctl-mock: subcommand not implemented: checkpointctl {cmd} {sub or ''}", file=sys.stderr)
        return 2
    print(__doc__)
    return 0


if __name__ == "__main__":
    sys.exit(main())
